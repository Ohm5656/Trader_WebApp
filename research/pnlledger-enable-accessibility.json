{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "headless": true
  },
  "start_url": { "url": "https://app.pnlledger.com/welcome" },
  "environment": {
    "viewport": { "width": 390, "height": 844, "device_scale_factor": 1 },
    "locale": "en-US",
    "timezone": "UTC",
    "color_scheme": "dark",
    "reduced_motion": "reduce",
    "service_workers": "allow"
  },
  "actions": [
    {
      "step_id": "enable-flutter-semantics",
      "action": "click",
      "locator": { "kind": "role", "role": "button", "name": "Enable accessibility" },
      "timeout_ms": 10000
    },
    { "step_id": "settle-semantics", "action": "wait_for_timeout", "duration_ms": 1500 }
  ],
  "capture": {
    "after_each_step": ["url", "accessibility"],
    "at_end": ["url", "accessibility", "screenshot"],
    "events": ["console", "page-errors"],
    "network": { "request_body": false, "response_body": false, "header_values": false }
  }
}
